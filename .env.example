# Private values belong only in your ignored .env or protected deployment settings.
PORT=4173
NODE_ENV=production
LOOKOUT_MODE=secure
LOOKOUT_AUTH=supabase

# Two distinct restricted logins; never use the migration administrator here.
# DATABASE_URL=postgresql://lookout_app.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# AUTH_DATABASE_URL=postgresql://lookout_identity_app.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# The reviewed public Supabase root CA is bundled; omit laptop-specific sslrootcert paths.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Set only after choosing the actual stable HTTPS address, with no trailing slash.
# APP_ORIGIN=https://YOUR_ACTUAL_DEPLOYMENT_HOST

# Owner connection belongs in the separate migration process only, not web runtime.
# MIGRATION_DATABASE_URL=postgresql://OWNER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
# No Anthropic key or paid model credits are required for the core workflow.
# Local-only account demo: npm run demo:secure (runs with explicit development settings).
