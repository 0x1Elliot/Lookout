# Secure mode is the default. Do not put actual secrets in this example.
PORT=4173
# Set NODE_ENV=production for hosted deployment.
LOOKOUT_MODE=secure
LOOKOUT_AUTH=supabase
# Set these privately in your environment or ignored .env file:
# DATABASE_URL=postgresql://lookout_app:...@database-host/lookout?sslmode=verify-full
# MIGRATION_DATABASE_URL=postgresql://migration-owner:...@database-host/lookout?sslmode=verify-full
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# APP_ORIGIN=https://your-lookout-site.example
# No Anthropic key is required or used.
# For a working local database and email/password demo, use: npm run demo:secure
# Legacy browser-only prototype: npm run start:demo (never in production).

# Setup: docs/supabase-setup.md. After configuration: npm run check:supabase
# Remove MIGRATION_DATABASE_URL from the web runtime after applying migrations.
